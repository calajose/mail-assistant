#!/usr/bin/env bash
set -euo pipefail

PROJECT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
VENV_DIR="${PROJECT_DIR}/venv"

if [[ ! -x "${VENV_DIR}/bin/python" ]]; then
  echo "Error: no se encontro el entorno virtual en ${VENV_DIR}" >&2
  echo "Crea el entorno e instala el paquete con:" >&2
  echo "  python -m venv venv && source venv/bin/activate && pip install ." >&2
  exit 1
fi

# shellcheck disable=SC1091
source "${VENV_DIR}/bin/activate"

exec mail-assistant "$@"
